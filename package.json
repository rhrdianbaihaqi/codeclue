{
  "name": "codeclue",
  "version": "0.1.0-alpha.0",
  "description": "Extract codebase structure for AI coding agents — understand unfamiliar code with minimal tokens",
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "dev": "tsup --watch",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai",
    "llm",
    "context",
    "tokens",
    "typescript"
  ],
  "author": "rahardianz",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "clue": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhrdianbaihaqi/codeclue.git"
  },
  "homepage": "https://github.com/rhrdianbaihaqi/codeclue#readme",
  "bugs": {
    "url": "https://github.com/rhrdianbaihaqi/codeclue/issues"
  }
}
